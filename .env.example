# ---------- Database (PostgreSQL) ----------
# Neon / Supabase / Vercel Postgres / any Postgres. Example:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/onesmile?sslmode=require"

# OPTIONAL – Neon/Supabase: if DATABASE_URL is a *pooled* URL, put the direct (non-pooled) one here.
# It is used only for migrations during the build.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/onesmile?sslmode=require"

# ---------- Public site ----------
# Your live domain, no trailing slash (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# ---------- Admin ----------
# Used ONCE to create the first admin account (only if no admin exists yet).
# The admin is forced to choose a new password at first login.
ADMIN_USERNAME="onesmiledental"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_BEFORE_FIRST_RUN"

# Random string, 32+ characters. Generate with:  openssl rand -base64 48
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"

# Random string used to hash visitor IPs for rate limiting (never store raw IPs)
IP_HASH_SALT="REPLACE_WITH_ANOTHER_RANDOM_STRING"

# ---------- WhatsApp Business Platform (Meta Cloud API) ----------
# Leave these empty to run the site without WhatsApp: bookings still work, nothing is sent.
# Permanent System User token (Meta Business Settings → System users → Generate token, whatsapp_business_messaging)
WHATSAPP_ACCESS_TOKEN=""
# Phone number ID of the clinic's WhatsApp Business number (Meta developer dashboard → WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=""
# Optional (defaults: v21.0 / en)
# WHATSAPP_API_VERSION="v21.0"
# WHATSAPP_TEMPLATE_LANG="en"
# Names of the APPROVED message templates (see README → WhatsApp setup). If a name is empty, a plain text
# message is sent instead, which Meta only delivers inside a 24-hour conversation window.
WHATSAPP_TEMPLATE_PATIENT_CONFIRMATION="appointment_confirmed"
WHATSAPP_TEMPLATE_DOCTOR_DAILY="doctor_daily_schedule"
WHATSAPP_TEMPLATE_DOCTOR_LATE="doctor_new_booking"
# Doctor's WhatsApp number for the daily summary (defaults to the doctor phone in Admin → Settings)
DOCTOR_WHATSAPP_NUMBER="0332-3259577"

# ---------- Scheduler ----------
# Random string, 16+ characters. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"
